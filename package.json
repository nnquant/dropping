{
  "name": "dropping",
  "version": "0.1.1",
  "private": true,
  "description": "A focused two-pane SFTP file transfer client built with Rust and Tauri",
  "license": "MIT",
  "author": "nnquant and Dropping contributors",
  "homepage": "https://github.com/nnquant/dropping",
  "repository": {
    "type": "git",
    "url": "https://github.com/nnquant/dropping.git"
  },
  "bugs": "https://github.com/nnquant/dropping/issues",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "test": "vitest run",
    "test:sftp": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-sftp-tests.ps1"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "highlight.js": "^11.12.0",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "hyparquet-writer": "^0.16.10",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
